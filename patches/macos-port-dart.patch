+/// 打开 macOS 下的本地核心。
+///
+/// dylib 被打包进 .app/Contents/Frameworks，并带有 @rpath 安装名，
+/// 因此优先让 dyld 自行解析；解析不到时再按常见位置逐一尝试。
+DynamicLibrary _openMacCore() {
+  const names = ['libduanju_core.dylib', 'duanju_core.dylib'];
+  final bundle = Platform.resolvedExecutable;
+  final roots = <String>[
+    path.dirname(bundle),
+    path.join(path.dirname(bundle), 'Frameworks'),
+    path.join(path.dirname(bundle), 'MacOS'),
+    path.join(path.dirname(path.dirname(bundle)), 'Frameworks'),
+  ];
+  final attempts = <String>['@rpath/libduanju_core.dylib', ...names];
+  for (final name in attempts) {
+    for (final root in roots) {
+      final candidate = path.join(root, name);
+      try {
+        if (name.startsWith('@rpath') || File(candidate).existsSync()) {
+          return DynamicLibrary.open(candidate);
+        }
+      } catch (_) {
+        continue;
+      }
+    }
+  }
+  try {
+    return DynamicLibrary.process();
+  } catch (_) {
+    throw StateError(
+      '未能加载本地核心 libduanju_core.dylib，请确认应用包内 Frameworks 目录存在该文件。',
+    );
+  }
+}

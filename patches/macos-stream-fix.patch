+// streamLog 把诊断信息写到固定文件。
+// 用 fmt.Printf 时 stdout 在 `open` 启动下无处可去，改为落盘便于排查。
+func streamLog(format string, args ...any) {
+	line := time.Now().Format("15:04:05.000") + " " + fmt.Sprintf(format, args...)
+	// 沙箱内 /tmp 不可写，改用容器 home 下必然可写的位置。
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return
+	}
+	paths := []string{
+		filepath.Join(home, "Library", "Caches", "duanju-stream.log"),
+		filepath.Join(os.TempDir(), "duanju-stream.log"),
+	}
+	for _, p := range paths {
+		if f, err := os.OpenFile(p, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644); err == nil {
+			fmt.Fprintln(f, line)
+			f.Close()
+			return
+		}
+	}
+}
